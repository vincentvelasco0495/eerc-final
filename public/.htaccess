# Hostinger serves .mjs as text/plain. Browsers then refuse the PDF.js worker
# (quiz PDF upload: "Failed to fetch dynamically imported module").
<IfModule mod_mime.c>
  AddType application/javascript .mjs
</IfModule>
<FilesMatch "\.mjs$">
  ForceType application/javascript
</FilesMatch>

RewriteEngine On

# Missing scripts must not fall through to index.html. A 200 HTML body is cached
# as JavaScript and surfaces as "Failed to fetch dynamically imported module".
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} \.(js|mjs|css|map|json|woff2?|png|jpe?g|gif|webp|svg|ico)$ [NC]
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
